{
  "$schema": "packwire-v1",
  "id": "ventoy",
  "name": "Ventoy",
  "aliases": ["ventoy", "multiboot-usb", "usb-multiboot"],
  "icon": "https://raw.githubusercontent.com/ventoy/Ventoy/master/ICON/logo_128.png",
  "type": "stable",
  "category": "system tools",
  "description": "Herramienta open source para crear USB multiboot copiando directamente imágenes ISO, WIM, IMG, VHD(x) y EFI.",
  "upstream": {
    "source": "github_ventoy",
    "repository": "ventoy/Ventoy",
    "channel": "stable"
  },
  "install": {
    "mode": "here",
    "here": {
      "format": "zip",
      "binaries": ["Ventoy2Disk.exe"],
      "addpath": true
    },
    "site": {
      "url": "https://www.ventoy.net/en/download.html"
    },
    "clean": true
  }
}
