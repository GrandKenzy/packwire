{
  "$schema": "packwire-v1",
  "id": "c-gcc",
  "name": "C/C++ (GCC · w64devkit)",
  "aliases": ["c", "gcc", "g++", "w64devkit", "mingw"],
  "icon": "⚙️",
  "type": "stable",
  "category": "compilers",
  "description": "GCC, G++, GDB, GNU Make y CMake para Windows desde el release estable más reciente de w64devkit.",
  "upstream": {
    "source": "github_w64devkit",
    "repository": "skeeto/w64devkit",
    "channel": "stable"
  },
  "install": {
    "mode": "here",
    "here": {
      "format": "7z-sfx",
      "binaries": ["gcc.exe", "g++.exe", "c++.exe", "cpp.exe", "as.exe", "ld.exe", "gdb.exe", "make.exe", "ar.exe", "ranlib.exe", "windres.exe"],
      "addpath": true
    },
    "site": {
      "url": "https://github.com/skeeto/w64devkit/releases"
    },
    "clean": true
  }
}
