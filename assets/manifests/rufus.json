{
  "$schema": "packwire-v1",
  "id": "rufus",
  "name": "Rufus",
  "aliases": ["rufus", "usb-creator", "bootable-usb"],
  "icon": "https://raw.githubusercontent.com/pbatard/rufus/master/res/rufus.ico",
  "type": "stable",
  "category": "tools",
  "description": "Utilidad portable oficial para crear unidades USB de arranque desde ISO, Windows, Linux y otros medios.",
  "upstream": {
    "source": "github_rufus",
    "repository": "pbatard/rufus",
    "channel": "stable"
  },
  "install": {
    "mode": "here",
    "here": {
      "format": "portable-exe",
      "binaries": ["rufus.exe"],
      "addpath": true
    },
    "site": {
      "url": "https://rufus.ie/en/"
    },
    "clean": true
  }
}
